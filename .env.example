NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

DATABASE_URL=mysql://pixelpay:pixelpay@localhost:3306/pixelpay
# Override if port 3306 is already taken on your machine (also update DATABASE_URL above to match)
# MYSQL_HOST_PORT=3306

REDIS_URL=redis://localhost:6379

JWT_SECRET=change_me_64_chars_minimum_for_production_use_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_64_chars_minimum_random_string
JWT_REFRESH_EXPIRES_IN=7d

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# GB Prime Pay QR Cash — confirm this host with your account rep/dashboard before going
# live; GB Prime Pay's own docs sample used api.globalprimepay.com instead.
PAYMENT_GATEWAY_URL=https://api.gbprimepay.com
# "token" from gbprimepay.com > Profile > Gen Token. QR Cash must be enabled first by
# emailing info@gbprimepay.com and accepting their terms.
PAYMENT_GATEWAY_API_KEY=
# merchant secret key, used only for the authenticated status-query API (Basic auth)
PAYMENT_GATEWAY_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@pixelpay.local

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pixelpay
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:3000
